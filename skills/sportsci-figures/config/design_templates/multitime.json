{
  "design": "multitime",
  "title": {"zh": "16周力量训练的时间进程：四个时点的平行组研究（模板）", "en": "Time course of a 16-week strength programme: a parallel-group study with four assessments (template)"},
  "language": "zh",
  "simulated": true,
  "columns": {"id": "id", "group": "group", "time": "time"},
  "groups": {
    "order": ["CON", "INT"],
